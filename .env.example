# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RAPIDAPI_KEY: RapidAPI credentials for live sports feeds (API-Football / FlashScore / LiveScore)
RAPIDAPI_KEY="ae7a8a84d8msh7b71efb77e1029fp1b2f10jsnbb34244ac998"

# FOOTBALL_DATA_API_KEY: Official live football scores and fixtures API token (football-data.org)
FOOTBALL_DATA_API_KEY="39e55131da8f4ea88f8f004e83df5d90"

# APISPORTS_KEY: Direct API-Sports key (api-sports.io)
APISPORTS_KEY="0510399bf63062e9f11c9a07be52b2a7"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
